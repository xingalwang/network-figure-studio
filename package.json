{
  "name": "network-figure-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "start": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:tools",
    "test:tools": "node --test scripts/*.test.mjs",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run format:check && npm run check:architecture && npm run typecheck && npm test",
    "verify": "npm run check && npm run test:e2e && npm run build",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "dependencies": {
    "@maxgraph/core": "0.25.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "description": "Local-first tensor architecture drawing workstation",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  }
}
